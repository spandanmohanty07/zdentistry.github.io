---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { generateArticleSchema, generateBreadcrumbSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const siteUrl = 'https://zdentistry.in';
const postUrl = `${siteUrl}/blog/${post.slug}/`;

const articleSchema = generateArticleSchema(
  post.data.title,
  post.data.description,
  postUrl,
  post.data.pubDate,
  post.data.updatedDate || post.data.pubDate,
  post.data.image
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'Blog', url: `${siteUrl}/blog/` },
  { name: post.data.title, url: postUrl },
]);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={postUrl}
  type="article"
  structuredData={[articleSchema, breadcrumbSchema]}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-gray-50 border-b border-gray-100">
    <div class="container-custom py-3">
      <ol class="flex items-center space-x-2 text-sm text-secondary-500">
        <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
        <li><span class="text-gray-300">/</span></li>
        <li><a href="/blog/" class="hover:text-primary transition-colors">Blog</a></li>
        <li><span class="text-gray-300">/</span></li>
        <li class="text-secondary-700 font-medium truncate max-w-[180px] sm:max-w-xs">{post.data.title}</li>
      </ol>
    </div>
  </nav>

  <!-- Article Header -->
  <section class="section bg-gradient-to-br from-primary-50 to-white">
    <div class="container-custom max-w-3xl mx-auto">
      <div class="flex gap-2 flex-wrap mb-4">
        {post.data.tags?.map((tag) => (
          <span class="text-xs bg-primary/10 text-primary font-medium px-3 py-1 rounded-full">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-secondary-900 leading-tight mb-6">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-4 text-sm text-secondary-500">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <span class="font-medium text-secondary-700">{post.data.author}</span>
        </div>
        <span>·</span>
        <time datetime={post.data.pubDate}>
          {new Date(post.data.pubDate).toLocaleDateString('en-IN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.data.updatedDate && post.data.updatedDate !== post.data.pubDate && (
          <>
            <span>·</span>
            <span>Updated: {new Date(post.data.updatedDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <article class="prose prose-lg max-w-none prose-headings:text-secondary-900 prose-headings:font-bold prose-headings:scroll-mt-20 prose-p:text-secondary-600 prose-p:leading-relaxed prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-strong:text-secondary-800 prose-li:text-secondary-600 prose-table:w-full prose-table:text-sm prose-th:bg-gray-50 prose-th:text-secondary-800 prose-td:text-secondary-600 prose-hr:border-gray-200 prose-hr:my-8 prose-blockquote:border-primary prose-blockquote:text-secondary-600 prose-blockquote:not-italic prose-blockquote:bg-primary-50 prose-blockquote:rounded-r-lg prose-blockquote:py-1">
          <Content />
        </article>

        <!-- Author Bio -->
        <div class="mt-12 p-6 bg-gray-50 rounded-2xl border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-secondary-900">Dr. Zuben Mohanty, MDS</p>
              <p class="text-sm text-primary font-medium">Oral & Maxillofacial Surgeon | Founder, ZDentistry</p>
              <p class="text-sm text-secondary-600 mt-2">
                Dr. Zuben Mohanty is a qualified Oral & Maxillofacial Surgeon and the founder of ZDentistry in CDA Sector-9, Cuttack. He specialises in dental implants, cosmetic dentistry, maxillofacial surgery, and comprehensive oral care.
              </p>
              <a href="/about/" class="text-sm text-primary font-semibold hover:underline mt-2 inline-block">
                Learn more about Dr. Zuben →
              </a>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-8 p-6 bg-primary/5 rounded-2xl border border-primary/10 text-center">
          <h3 class="text-xl font-bold text-secondary-900 mb-2">Ready to book an appointment?</h3>
          <p class="text-secondary-600 text-sm mb-4">
            Visit ZDentistry at CDA Sector-9, Cuttack or call us at <a href="tel:+918984489929" class="text-primary font-semibold">+91 89844 89929</a>
          </p>
          <a href="/book-appointment/" class="btn-secondary inline-block">Book Appointment</a>
        </div>

        <!-- Back to Blog -->
        <div class="mt-8 text-center">
          <a href="/blog/" class="text-primary font-semibold hover:underline">
            ← Back to Dental Health Blog
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
