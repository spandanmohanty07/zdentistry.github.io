---
import PageLayout from '@/layouts/PageLayout.astro';

const breadcrumbs = [
  { name: 'Home', url: 'https://zdentistry.netlify.app' },
  { name: 'Book Appointment', url: 'https://zdentistry.netlify.app/book-appointment/' },
];

// ============================================
// CALENDLY CONFIGURATION
// ============================================
// To enable Calendly:
// 1. Create a free account at https://calendly.com
// 2. Set up your availability and event types
// 3. Replace the URL below with your Calendly link
//    Example: "https://calendly.com/zdentistry" or "https://calendly.com/dr-zuben"
// 4. Set CALENDLY_ENABLED to true
// ============================================
const CALENDLY_URL = "https://calendly.com/your-username"; // Replace with your Calendly URL
const CALENDLY_ENABLED = false; // Set to true once you have your Calendly account
---

<PageLayout
  title="Book Dental Appointment | ZDentistry Cuttack - CDA Sector-9"
  description="Book a dental appointment at ZDentistry in CDA Sector-9, Cuttack. Call +91 89844 89929, WhatsApp us, or use our online form. Same-day appointments available for emergencies. Flexible timing Mon–Sun."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="section bg-gradient-to-br from-primary-50 to-white">
    <div class="container-custom text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-secondary-900">
        Book Your <span class="text-primary">Appointment</span>
      </h1>
      <p class="text-lg text-secondary-600 mt-4 max-w-2xl mx-auto">
        Choose your preferred way to book. We're here to make scheduling as easy as possible for you and your family.
      </p>
    </div>
  </section>

  <!-- Booking Options Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Phone Booking -->
        <div class="card text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-secondary-900 mb-2">Call Us</h2>
          <p class="text-secondary-600 mb-4">
            Speak directly with our team to schedule your appointment.
          </p>
          <div class="space-y-2">
            <a href="tel:+918984489929" class="btn-primary w-full">
              +91 89844 89929
            </a>
            <a href="tel:+918984469929" class="btn-outline w-full">
              +91 89844 69929
            </a>
          </div>
        </div>

        <!-- WhatsApp Booking -->
        <div class="card text-center border-2 border-green-500">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-secondary-900 mb-2">WhatsApp</h2>
          <p class="text-secondary-600 mb-4">
            Quick and easy booking via WhatsApp message.
          </p>
          <a
            href="https://wa.me/918984489929?text=Hi!%20I%20would%20like%20to%20book%20an%20appointment%20at%20ZDentistry."
            target="_blank"
            rel="noopener noreferrer"
            class="btn bg-green-500 text-white hover:bg-green-600 w-full"
          >
            Chat on WhatsApp
          </a>
          <p class="text-sm text-green-600 mt-2 font-medium">Recommended</p>
        </div>

        <!-- Contact Form -->
        <div class="card text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-secondary-900 mb-2">Contact Form</h2>
          <p class="text-secondary-600 mb-4">
            Submit a request and we'll call you back.
          </p>
          <a href="/contact/" class="btn-primary w-full">
            Fill Contact Form
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Calendly Section -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-secondary-900 mb-4">
            {CALENDLY_ENABLED ? "Book Online" : "Online Scheduling Coming Soon"}
          </h2>
          <p class="text-secondary-600">
            {CALENDLY_ENABLED
              ? "Select a convenient time slot below to schedule your appointment."
              : "We're working on adding online scheduling for your convenience. In the meantime, please use phone or WhatsApp to book your appointment."
            }
          </p>
        </div>

        {CALENDLY_ENABLED ? (
          <!-- Calendly inline widget -->
          <div
            class="calendly-inline-widget rounded-xl overflow-hidden shadow-lg"
            data-url={`${CALENDLY_URL}?hide_gdpr_banner=1&primary_color=017AFF`}
            style="min-width:320px;height:700px;"
          ></div>
          <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
        ) : (
          <!-- Placeholder when Calendly is not configured -->
          <div class="bg-white rounded-xl p-8 shadow-sm border-2 border-dashed border-gray-300 text-center">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-gray-500 mb-4">Online booking calendar will be available here soon.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="tel:+918984489929" class="btn-primary">
                Call to Book
              </a>
              <a
                href="https://wa.me/918984489929?text=Hi!%20I%20would%20like%20to%20book%20an%20appointment%20at%20ZDentistry."
                target="_blank"
                rel="noopener noreferrer"
                class="btn bg-green-500 text-white hover:bg-green-600"
              >
                WhatsApp
              </a>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Business Hours Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-secondary-900 mb-8">
          Clinic Hours
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-gray-50 rounded-xl p-6">
            <h3 class="font-semibold text-secondary-900 mb-2">Monday - Saturday</h3>
            <p class="text-secondary-600">
              Morning: 10:00 AM - 2:00 PM<br />
              Evening: 5:00 PM - 9:00 PM
            </p>
          </div>
          <div class="bg-gray-50 rounded-xl p-6">
            <h3 class="font-semibold text-secondary-900 mb-2">Sunday</h3>
            <p class="text-secondary-600">
              Morning: 10:00 AM - 2:00 PM<br />
              <span class="text-sm">(Evening Closed)</span>
            </p>
          </div>
        </div>
        <div class="mt-8 p-4 bg-primary/10 rounded-xl">
          <p class="text-primary font-medium">
            For dental emergencies outside regular hours, please call us directly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-secondary-900 mb-4">
          Find Us
        </h2>
        <address class="not-italic text-secondary-600 text-lg mb-6">
          ZDentistry<br />
          2B / 109, Near Jugal Kishore Park<br />
          CDA Sector-9, Cuttack<br />
          Odisha 753014, India
        </address>
        <a
          href="https://maps.google.com/?q=ZDentistry+CDA+Sector+9+Cuttack"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Get Directions
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Reduce Calendly widget height on mobile so it doesn't overflow the viewport */
  @media (max-width: 767px) {
    .calendly-inline-widget {
      height: 520px !important;
      min-width: 100% !important;
    }
  }
</style>
