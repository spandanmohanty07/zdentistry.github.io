---
import PageLayout from '@/layouts/PageLayout.astro';
import TreatmentCard from '@/components/home/TreatmentCard.astro';
import CTASection from '@/components/home/CTASection.astro';
import { getCollection } from 'astro:content';

const allTreatments = await getCollection('treatments');
const dentistryTreatments = allTreatments
  .filter(t => t.data.category === 'dentistry')
  .sort((a, b) => a.data.order - b.data.order);

const breadcrumbs = [
  { name: 'Home', url: 'https://zdentistry.in' },
  { name: 'Treatments', url: 'https://zdentistry.in/treatments/' },
  { name: 'Dentistry', url: 'https://zdentistry.in/treatments/dentistry/' },
];
---

<PageLayout
  title="Dentistry Services"
  description="Comprehensive dental care services at ZDentistry, Cuttack. From routine check-ups to cosmetic dentistry, dental implants, and emergency dental care."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="section bg-gradient-to-br from-primary-50 to-white">
    <div class="container-custom text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-secondary-900">
        <span class="text-primary">Dentistry</span> Services
      </h1>
      <p class="text-lg text-secondary-600 mt-4 max-w-2xl mx-auto">
        From routine check-ups to advanced cosmetic treatments, our dental services help you maintain a healthy, beautiful smile.
      </p>
    </div>
  </section>

  <!-- Treatments Grid -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {dentistryTreatments.map((treatment) => (
          <TreatmentCard
            title={treatment.data.title}
            description={treatment.data.shortDescription}
            href={`/treatments/dentistry/${treatment.slug.split('/').pop()}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <h2 class="text-3xl font-bold text-center mb-12">Why Choose ZDentistry?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Experienced Team</h3>
          <p class="text-secondary-600">Expert dentists with years of experience in all dental procedures.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Modern Equipment</h3>
          <p class="text-secondary-600">State-of-the-art dental technology for precise and comfortable treatments.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Patient-Focused Care</h3>
          <p class="text-secondary-600">Personalized treatment plans tailored to your specific needs.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>
