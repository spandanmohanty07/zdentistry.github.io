---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTASection from '@/components/home/CTASection.astro';
import { getCollection } from 'astro:content';
import { generateReviewsWithRatingSchema, generateBreadcrumbSchema } from '@/lib/schema';

const testimonials = await getCollection('testimonials');
const sortedTestimonials = testimonials.sort((a, b) => a.data.order - b.data.order);

const siteUrl = 'https://zdentistry.netlify.app';
const pageUrl = `${siteUrl}/testimonials/`;

const title = "Patient Reviews | ZDentistry — Best Dentist in CDA Cuttack";
const description = "Read genuine Google reviews from ZDentistry patients in Cuttack. Our patients rate us 4.9/5 for painless dental care, friendly staff, and expert treatment by Dr. Zuben Mohanty (MDS). See why we're the top-rated dental clinic in CDA Sector-9.";

const reviewData = sortedTestimonials.map(t => ({
  author: t.data.name,
  text: t.data.text,
  rating: t.data.rating || 5,
  date: t.data.date,
}));

const reviewsSchema = generateReviewsWithRatingSchema(reviewData);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'Patient Reviews', url: pageUrl },
]);
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  structuredData={[reviewsSchema, breadcrumbSchema]}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-gray-50 border-b border-gray-100">
    <div class="container-custom py-3">
      <ol class="flex items-center space-x-2 text-sm text-secondary-500">
        <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
        <li><span class="text-gray-300">/</span></li>
        <li class="text-secondary-700 font-medium">Patient Reviews</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="section bg-gradient-to-br from-primary-50 to-white">
    <div class="container-custom text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-4">
        What Our Patients <span class="text-primary">Say About Us</span>
      </h1>
      <p class="text-lg text-secondary-600 max-w-2xl mx-auto mb-8">
        Real reviews from real patients at ZDentistry, CDA Sector-9, Cuttack. We're proud of every patient's experience and work hard to earn your trust.
      </p>
      <!-- Aggregate Rating Display -->
      <div class="inline-flex flex-col items-center bg-white rounded-2xl shadow-md px-10 py-6">
        <div class="flex gap-1 mb-2">
          {[...Array(5)].map(() => (
            <svg class="w-7 h-7 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <p class="text-4xl font-bold text-secondary-900">4.9 <span class="text-secondary-400 text-2xl font-normal">/ 5</span></p>
        <p class="text-secondary-500 text-sm mt-1">Based on Google Reviews</p>
        <a
          href="https://g.page/r/CRZ6N6fvkOdnEAE/review"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 text-primary font-semibold text-sm hover:underline"
        >
          Leave a Google Review &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Reviews Grid -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedTestimonials.map((t) => (
          <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 flex flex-col">
            <!-- Google logo + stars -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex gap-1">
                {[...Array(t.data.rating || 5)].map(() => (
                  <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <!-- Google icon -->
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
            </div>
            <!-- Review text -->
            <blockquote class="text-secondary-600 text-sm leading-relaxed flex-grow mb-4">
              "{t.data.text}"
            </blockquote>
            <!-- Reviewer info -->
            <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
              <div class="w-9 h-9 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-primary font-bold text-sm">{t.data.name.charAt(0)}</span>
              </div>
              <div>
                <p class="font-semibold text-secondary-900 text-sm">{t.data.name}</p>
                <p class="text-secondary-400 text-xs">{t.data.location}{t.data.date ? ` · ${new Date(t.data.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'short' })}` : ''}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Leave a review CTA -->
      <div class="mt-12 text-center">
        <div class="inline-block bg-primary/5 border border-primary/10 rounded-2xl px-8 py-6">
          <h2 class="text-2xl font-bold text-secondary-900 mb-2">Visited ZDentistry?</h2>
          <p class="text-secondary-600 mb-4">Your review helps other patients in Cuttack find quality dental care — and it only takes 60 seconds.</p>
          <a
            href="https://g.page/r/CRZ6N6fvkOdnEAE/review"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-block"
          >
            Write a Google Review
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Trust Us -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-secondary-900 mb-4">
          Why Patients in <span class="text-primary">Cuttack Trust ZDentistry</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center p-6 bg-white rounded-xl shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="font-bold text-secondary-900 mb-1">Expert Specialist</h3>
          <p class="text-secondary-600 text-sm">Dr. Zuben Mohanty holds an MDS in Oral & Maxillofacial Surgery — the highest qualification in dentistry.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-xl shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-secondary-900 mb-1">Painless Dentistry</h3>
          <p class="text-secondary-600 text-sm">Modern anaesthetic techniques and gentle care make every procedure as comfortable as possible.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-xl shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-secondary-900 mb-1">Family Clinic</h3>
          <p class="text-secondary-600 text-sm">We treat patients of all ages — children, adults, and seniors. Your whole family is welcome at ZDentistry.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
