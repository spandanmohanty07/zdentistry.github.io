---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTASection from '@/components/home/CTASection.astro';
import { generateLocalBusinessSchema, generateFAQSchema, generateBreadcrumbSchema } from '@/lib/schema';

const siteUrl = 'https://zdentistry.in';
const pageUrl = `${siteUrl}/dentist-in-cda-cuttack/`;

const title = "Dentist in CDA Cuttack | Best Dental Clinic in CDA Sector-9 | ZDentistry";
const description = "Looking for a trusted dentist in CDA Cuttack? ZDentistry is the top-rated dental clinic in CDA Sector-9, near Jugal Kishore Park. Expert dental care, dental implants & maxillofacial surgery by Dr. Zuben Mohanty (MDS). Call +91 89844 89929.";

const faqs = [
  {
    question: "Where is ZDentistry located in CDA Cuttack?",
    answer: "ZDentistry is located at 2B/109, Near Jugal Kishore Park, CDA Sector-9, Cuttack, Odisha 753014. We are easily accessible from all CDA sectors including Sector 6, 7, 8, and 10, as well as Bidanasi, Madhupatna, and central Cuttack.",
  },
  {
    question: "What are the clinic hours at ZDentistry CDA?",
    answer: "ZDentistry is open Monday to Saturday from 10 AM to 2 PM and 5 PM to 9 PM, and Sunday from 10 AM to 2 PM. We also see emergency dental patients during clinic hours — call +91 89844 89929 for same-day emergency appointments.",
  },
  {
    question: "Which areas near CDA does ZDentistry serve?",
    answer: "ZDentistry in CDA Sector-9 serves patients from all CDA sectors (6, 7, 8, 9, 10), Bidanasi, Madhupatna, Chauliaganj, Ranihat, College Square, Buxi Bazaar, Shelter Chhak, Khan Nagar, Link Road, Tulsipur, Jobra, and across Cuttack. We also see patients from Bhubaneswar.",
  },
  {
    question: "Who is the dentist at ZDentistry in CDA Cuttack?",
    answer: "Dr. Zuben Mohanty (MDS) is the founder and lead dentist at ZDentistry CDA. He is a qualified Oral & Maxillofacial Surgeon with extensive experience in dental implants, cosmetic dentistry, root canal treatment, and complex maxillofacial surgery.",
  },
  {
    question: "Does ZDentistry CDA offer dental implants?",
    answer: "Yes, ZDentistry in CDA Cuttack specialises in dental implants. Dr. Zuben Mohanty (MDS, Oral & Maxillofacial Surgeon) performs implant placement with precision and expertise. We offer a consultation to assess your suitability and provide a detailed cost estimate.",
  },
  {
    question: "Is ZDentistry in CDA good for children?",
    answer: "Absolutely. ZDentistry in CDA Sector-9 is a family dental clinic — we treat patients of all ages, from toddlers to seniors. Our team is experienced in making children's dental visits comfortable and positive. We recommend children's first dental visit by age 3 or when their first teeth appear.",
  },
];

const localBusinessSchema = generateLocalBusinessSchema();
const faqSchema = generateFAQSchema(faqs);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'Dentist in CDA Cuttack', url: pageUrl },
]);

const services = [
  { name: 'Dental Check-up & Cleaning', desc: 'Comprehensive exam and professional scaling by expert dental hygienists.', href: '/treatments/dentistry/' },
  { name: 'Dental Implants', desc: 'Permanent, natural-looking tooth replacement by a specialist Oral Surgeon.', href: '/treatments/dentistry/' },
  { name: 'Root Canal Treatment', desc: 'Painless root canal therapy to save infected teeth. Modern, comfortable technique.', href: '/blog/root-canal-treatment-cuttack/' },
  { name: 'Teeth Whitening', desc: 'Professional whitening for a brighter, more confident smile.', href: '/blog/teeth-whitening-cuttack/' },
  { name: 'Children\'s Dentistry', desc: 'Gentle, fun dental care for kids — building great habits from the start.', href: '/blog/childrens-dental-care-cuttack/' },
  { name: 'Emergency Dental Care', desc: 'Same-day emergency appointments for toothache, broken teeth, and abscesses.', href: '/blog/emergency-dentist-cuttack/' },
  { name: 'Gum Disease Treatment', desc: 'Expert diagnosis and treatment of gingivitis and periodontitis at all stages.', href: '/blog/gum-disease-treatment-cuttack/' },
  { name: 'Maxillofacial Surgery', desc: 'Specialist surgery for jaw conditions, facial trauma, TMJ disorders, and oral cancer.', href: '/treatments/maxillofacial/' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  structuredData={[localBusinessSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-gray-50 border-b border-gray-100">
    <div class="container-custom py-3">
      <ol class="flex items-center space-x-2 text-sm text-secondary-500">
        <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
        <li><span class="text-gray-300">/</span></li>
        <li class="text-secondary-700 font-medium">Dentist in CDA Cuttack</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="section bg-gradient-to-br from-primary-50 to-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-primary/10 text-primary text-sm font-semibold px-4 py-2 rounded-full mb-6">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          CDA Sector-9, Cuttack
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-secondary-900 leading-tight mb-6">
          Your Trusted <span class="text-primary">Dentist in CDA Cuttack</span>
        </h1>
        <p class="text-xl text-secondary-600 mb-8 max-w-3xl mx-auto">
          ZDentistry is CDA's top-rated dental clinic, located at Sector-9 near Jugal Kishore Park. Led by Dr. Zuben Mohanty (MDS, Oral & Maxillofacial Surgeon), we provide expert dental care for the whole family.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/book-appointment/" class="btn-secondary">Book Appointment</a>
          <a href="tel:+918984489929" class="btn-outline">Call +91 89844 89929</a>
        </div>
        <!-- Trust signals -->
        <div class="mt-10 flex flex-wrap justify-center gap-6 text-sm text-secondary-600">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span><strong>4.9/5</strong> Google Rating</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
            <span>MDS Qualified Specialist</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>CDA Sector-9, Cuttack</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Open 7 Days a Week</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-secondary-900 mb-4">
            Conveniently Located in <span class="text-primary">CDA Sector-9</span>
          </h2>
          <p class="text-secondary-600 mb-4">
            ZDentistry is situated at <strong>2B/109, Near Jugal Kishore Park, CDA Sector-9, Cuttack</strong> — one of the most accessible locations in the CDA township. Patients from across Cuttack choose us because of our central location, easy parking, and convenient hours.
          </p>
          <p class="text-secondary-600 mb-6">
            We serve patients from all CDA sectors and surrounding areas:
          </p>
          <div class="grid grid-cols-2 gap-2 mb-6">
            {['CDA Sector 6', 'CDA Sector 7', 'CDA Sector 8', 'CDA Sector 10', 'Bidanasi', 'Madhupatna', 'Chauliaganj', 'Ranihat', 'College Square', 'Buxi Bazaar', 'Khan Nagar', 'Link Road Cuttack'].map(area => (
              <div class="flex items-center gap-2 text-sm text-secondary-600">
                <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {area}
              </div>
            ))}
          </div>
          <div class="bg-gray-50 rounded-xl p-4 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <div>
                <p class="font-semibold text-secondary-800 text-sm">Address</p>
                <p class="text-secondary-600 text-sm">2B/109, Near Jugal Kishore Park, CDA Sector-9, Cuttack, Odisha 753014</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <div>
                <p class="font-semibold text-secondary-800 text-sm">Phone</p>
                <a href="tel:+918984489929" class="text-primary text-sm font-medium">+91 89844 89929</a>
                <span class="text-secondary-400 text-sm"> | </span>
                <a href="tel:+918984469929" class="text-primary text-sm font-medium">+91 89844 69929</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <p class="font-semibold text-secondary-800 text-sm">Hours</p>
                <p class="text-secondary-600 text-sm">Mon–Sat: 10 AM–2 PM & 5 PM–9 PM</p>
                <p class="text-secondary-600 text-sm">Sunday: 10 AM–2 PM</p>
              </div>
            </div>
          </div>
        </div>
        <!-- Map Embed -->
        <div class="rounded-2xl overflow-hidden shadow-lg h-96">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3742.4!2d85.8830!3d20.4625!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a19a75fa53c5b85%3A0xc9e790ef37a79a16!2sZ%20Dentistry%20%7C%20Dental%20Clinic!5e0!3m2!1sen!2sin!4v1"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="ZDentistry location map — CDA Sector-9, Cuttack"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary-900 mb-4">
          Dental Services at Our <span class="text-primary">CDA Cuttack Clinic</span>
        </h2>
        <p class="text-secondary-600 max-w-2xl mx-auto">
          From routine check-ups to specialist surgery, ZDentistry in CDA Sector-9 offers comprehensive dental care under one roof.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map(service => (
          <a href={service.href} class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow group">
            <h3 class="font-semibold text-secondary-900 mb-2 group-hover:text-primary transition-colors">{service.name}</h3>
            <p class="text-secondary-600 text-sm">{service.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About Dr Zuben -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <h2 class="text-3xl font-bold text-secondary-900 mb-4">
              Meet Your CDA Dentist — <span class="text-primary">Dr. Zuben Mohanty, MDS</span>
            </h2>
            <p class="text-secondary-600 mb-4">
              Dr. Zuben Mohanty is a qualified <strong>Oral & Maxillofacial Surgeon</strong> with an MDS degree, and the founder of ZDentistry. He brings specialist-level expertise to every patient — whether it is a routine cleaning, a dental implant, or complex jaw surgery.
            </p>
            <p class="text-secondary-600 mb-4">
              Patients in CDA Cuttack choose Dr. Zuben because of his calm, thorough approach, his commitment to painless dentistry, and his ability to explain complex treatment options clearly.
            </p>
            <ul class="space-y-2 mb-6">
              {[
                'MDS — Oral & Maxillofacial Surgery',
                'Specialist in dental implants and facial surgery',
                'Experienced in complex and emergency dental cases',
                'Fluent in English, Hindi, and Odia',
              ].map(point => (
                <li class="flex items-center gap-2 text-secondary-600 text-sm">
                  <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
            <a href="/about/" class="btn-outline inline-block">About Dr. Zuben</a>
          </div>
          <div class="bg-primary/5 rounded-2xl p-6 text-center">
            <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <p class="font-bold text-secondary-900">Dr. Zuben Mohanty</p>
            <p class="text-primary text-sm font-medium">MDS</p>
            <p class="text-secondary-500 text-sm">Oral & Maxillofacial Surgeon</p>
            <p class="text-secondary-500 text-sm mt-1">Founder, ZDentistry</p>
            <div class="mt-4 flex justify-center gap-1">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-xs text-secondary-500 mt-1">4.9/5 on Google</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-secondary-900 mb-4">
          Frequently Asked Questions — <span class="text-primary">CDA Cuttack Dental Clinic</span>
        </h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-4">
        {faqs.map((faq, index) => (
          <details class="bg-white rounded-xl p-6 shadow-sm group" open={index === 0}>
            <summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-lg">
              {faq.question}
              <svg class="w-5 h-5 transform group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-4 text-gray-600 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
