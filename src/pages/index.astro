---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import TreatmentCard from '@/components/home/TreatmentCard.astro';
import TestimonialCarousel from '@/components/home/TestimonialCarousel.astro';
import CTASection from '@/components/home/CTASection.astro';
import { getCollection } from 'astro:content';
import { generateReviewsWithRatingSchema } from '@/lib/schema';

// Get treatments
const allTreatments = await getCollection('treatments');
const dentistryTreatments = allTreatments
  .filter(t => t.data.category === 'dentistry')
  .sort((a, b) => a.data.order - b.data.order);
const maxillofacialTreatments = allTreatments
  .filter(t => t.data.category === 'maxillofacial')
  .sort((a, b) => a.data.order - b.data.order);

// Get testimonials
const testimonials = await getCollection('testimonials');
const sortedTestimonials = testimonials.sort((a, b) => a.data.order - b.data.order);

// SEO-optimized for target keywords
const title = "Best Dentist in Cuttack | #1 Dental Clinic Near You | ZDentistry CDA";
const description = "Looking for the best dentist near you in Cuttack? ZDentistry is the top-rated dental clinic in CDA Sector-9, Cuttack. Expert dental implants, cosmetic dentistry & maxillofacial surgery. ⭐ 4.9/5 Rating. Book now: +91 89844 89929";

// Generate combined reviews + aggregateRating schema (Google requires both together)
const reviewData = sortedTestimonials.map(t => ({
  author: t.data.name,
  text: t.data.text,
  rating: t.data.rating || 5,
  date: t.data.date,
}));
const reviewsSchema = generateReviewsWithRatingSchema(reviewData);
---

<BaseLayout
  title={title}
  description={description}
  structuredData={reviewsSchema}
>
  <Hero />

  <!-- Why Best Dental Clinic Section - SEO optimized -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary-900 mb-4">
          Why ZDentistry is the <span class="text-primary">Best Dental Clinic in Cuttack</span>
        </h2>
        <p class="text-secondary-600 max-w-3xl mx-auto">
          Searching for "dentist near me" or "best dentist in Cuttack"? You deserve dental professionals who truly deliver excellence. Here's why patients across Cuttack, CDA, and Bhubaneswar choose ZDentistry for teeth cleaning, gum disease treatment, and more.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="text-center p-6 rounded-xl bg-gray-50">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Expert MDS Dentist</h3>
          <p class="text-secondary-600 text-sm">Dr. Zuben Mohanty, a qualified Oral & Maxillofacial Surgeon. Years of experience treating teeth and gum conditions, from routine care to complex surgery.</p>
        </div>
        <div class="text-center p-6 rounded-xl bg-gray-50">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Modern Equipment</h3>
          <p class="text-secondary-600 text-sm">State-of-the-art technology for painless teeth cleaning, gum disease treatment, and precise surgical procedures.</p>
        </div>
        <div class="text-center p-6 rounded-xl bg-gray-50">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Prime Location</h3>
          <p class="text-secondary-600 text-sm">Conveniently located in CDA Sector-9, easily accessible from all areas of Cuttack</p>
        </div>
        <div class="text-center p-6 rounded-xl bg-gray-50">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Affordable Prices</h3>
          <p class="text-secondary-600 text-sm">Quality dental care at reasonable prices. Transparent billing for every service — from professional cleaning to advanced procedures.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <img
              src="/images/clinic-2.png"
              alt="ZDentistry clinic interior with modern equipment and blue cabinets"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
          <p class="text-lg text-secondary-600 italic mt-6">
            "Eliminate the Unknown - Trust in Our Professional Dental Care for a Stress-Free Visit"
          </p>
        </div>
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-secondary-900 mb-6">
            Dental Care That Feels Like Catching Up With an Old Friend
          </h2>
          <p class="text-secondary-600 mb-4">
            At ZDentistry, your oral health comes first. We provide exceptional care in a warm, welcoming environment. Our team listens to your concerns, explains every step, and delivers results you can trust.
          </p>
          <p class="text-secondary-600 mb-4">
            From professional cleaning to treating tooth decay, we stay current with the latest advancements in dentistry. Every visit is designed to prevent problems before they start — and fix them quickly when they do.
          </p>
          <p class="text-secondary-600 mb-6">
            We build relationships on trust and mutual respect. Our personalized approach to dental care sets us apart from the rest.
          </p>
          <p class="font-semibold text-secondary-900">
            Choose ZDentistry for your family's dental needs. Leave our clinic feeling confident, cared for, and smiling!
          </p>
          <a href="/about/" class="btn-outline mt-6 inline-block">
            Learn More About Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Carousel - Mobile Optimized -->
  <TestimonialCarousel
    testimonials={sortedTestimonials.map(t => ({
      name: t.data.name,
      role: t.data.role,
      location: t.data.location,
      text: t.data.text,
    }))}
  />

  <!-- Experience Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <img
              src="/images/clinic-1.png"
              alt="Modern dental treatment room at ZDentistry"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <h2 class="text-3xl md:text-4xl font-bold text-secondary-900 mb-6">
            <span class="text-primary">Experience matters,</span><br />
            and so do you
          </h2>
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-secondary-600">Put your teeth and gum health in experienced hands. Our dental hygienists and specialists work together for the best outcomes.</p>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-secondary-600">Book the kids in at the same time as you. We make family dental visits simple and convenient.</p>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-secondary-600">Get guidance on fluoride toothpaste, daily care routines, and preventive strategies to protect your smile long-term.</p>
            </div>
          </div>
          <a href="tel:+918984489929" class="btn-secondary mt-8 inline-block">
            Reach us @ +91 89844 89929
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Comprehensive Oral Health Section -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary-900 mb-4">
          Comprehensive <span class="text-primary">Oral Health</span> Care
        </h2>
        <p class="text-secondary-600 max-w-3xl mx-auto">
          Good oral health is about more than just a bright smile. It affects your overall well-being — from healthy blood vessels to a strong immune system. At ZDentistry, we take a whole-body approach to dental care.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <h3 class="text-lg font-semibold text-secondary-900 mb-3">Prevent Tooth Decay</h3>
          <p class="text-secondary-600 text-sm">
            Tooth decay is one of the most common dental problems — but it's also one of the most preventable. Our dental hygienists provide thorough cleanings and check-ups to catch issues early. We recommend fluoride toothpaste and sealants to strengthen enamel and keep cavities at bay.
          </p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <h3 class="text-lg font-semibold text-secondary-900 mb-3">Fight Gum Disease</h3>
          <p class="text-secondary-600 text-sm">
            Gum disease starts silently and can lead to serious complications if left untreated. Inflamed gums can affect blood vessels and overall health. Our team detects early signs of gum disease during every visit, so you get timely treatment and peace of mind.
          </p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <h3 class="text-lg font-semibold text-secondary-900 mb-3">Daily Care Guidance</h3>
          <p class="text-secondary-600 text-sm">
            Great teeth and gum health starts at home. Our dental professionals educate you on the right brushing techniques, the best fluoride toothpaste for your needs, and habits that protect your smile between visits. Prevention is always better than cure.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dentistry Treatments Section -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary-900 mb-4">
          Our Treatments
        </h2>
        <h3 class="text-2xl font-display text-primary">Dentistry</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {dentistryTreatments.map((treatment) => (
          <TreatmentCard
            title={treatment.data.title}
            description={treatment.data.shortDescription}
            href={`/treatments/dentistry/${treatment.slug.split('/').pop()}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Maxillofacial Treatments Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h3 class="text-2xl font-display text-primary">Maxillofacial Surgery</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {maxillofacialTreatments.map((treatment) => (
          <TreatmentCard
            title={treatment.data.title}
            description={treatment.data.shortDescription}
            href={`/treatments/maxillofacial/${treatment.slug.split('/').pop()}/`}
          />
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/treatments/" class="btn-outline">
          View All Treatments
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
