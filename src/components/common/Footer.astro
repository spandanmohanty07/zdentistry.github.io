---
const treatments = [
  { label: 'Dental Check-up', href: '/treatments/dentistry/dental-checkup/' },
  { label: 'Tooth Fillings', href: '/treatments/dentistry/tooth-fillings/' },
  { label: 'Cosmetic Dentistry', href: '/treatments/dentistry/cosmetic-dentistry/' },
  { label: 'Dental Implants', href: '/treatments/dentistry/dental-implants/' },
  { label: 'Emergency Dental', href: '/treatments/dentistry/emergency-dental/' },
];

const quickLinks = [
  { label: 'About Us', href: '/about/' },
  { label: 'All Treatments', href: '/treatments/' },
  { label: 'Contact Us', href: '/contact/' },
  { label: 'Book Appointment', href: '/book-appointment/' },
];

const socialLinks = [
  {
    label: 'Facebook',
    href: '#',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/></svg>`,
  },
  {
    label: 'Instagram',
    href: '#',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
  },
];
---

<footer class="bg-secondary-900 text-white">
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand Section -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-6">
          <img src="/logo.svg" alt="ZDentistry Logo" class="h-12 w-auto brightness-0 invert" />
        </a>
        <p class="text-gray-400 mb-6">
          Trust Your Smile to the Best: ZDentistry, Cuttack's Premier Dental Practice. Book for you and the family at the same time for real convenience!
        </p>
        <div class="flex gap-4">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              class="w-10 h-10 rounded-full bg-primary flex items-center justify-center hover:bg-primary-600 transition-colors"
              set:html={social.icon}
            />
          ))}
        </div>
      </div>

      <!-- Treatments -->
      <div>
        <h3 class="text-lg font-semibold mb-6">Treatments</h3>
        <ul class="space-y-3">
          {treatments.map((item) => (
            <li>
              <a href={item.href} class="text-gray-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-6">Quick Links</h3>
        <ul class="space-y-3">
          {quickLinks.map((item) => (
            <li>
              <a href={item.href} class="text-gray-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-semibold mb-6">Contact Us</h3>
        <div class="space-y-4">
          <div>
            <h4 class="font-medium text-sm text-gray-300 mb-1">Opening Hours</h4>
            <p class="text-gray-400 text-sm">
              Monday - Saturday<br />
              10AM - 2PM & 5PM - 9PM
            </p>
            <p class="text-gray-400 text-sm mt-2">
              Sunday<br />
              10AM - 2PM
            </p>
          </div>
          <div>
            <h4 class="font-medium text-sm text-gray-300 mb-1">Phone</h4>
            <a href="tel:+918984489929" class="text-gray-400 hover:text-white transition-colors block">
              +91 89844 89929
            </a>
            <a href="tel:+918984469929" class="text-gray-400 hover:text-white transition-colors block">
              +91 89844 69929
            </a>
          </div>
          <div>
            <h4 class="font-medium text-sm text-gray-300 mb-1">Address</h4>
            <address class="text-gray-400 text-sm not-italic">
              ZDentistry<br />
              2B / 109, Near Jugal Kishore Park<br />
              CDA Sector-9, Cuttack<br />
              Odisha 753014, India
            </address>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="border-t border-gray-800">
    <div class="container-custom py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-gray-400 text-sm">
          Copyright {new Date().getFullYear()} &copy; ZDentistry. All rights reserved.
        </p>
        <div class="flex gap-6 text-sm">
          <a href="/privacy/" class="text-gray-400 hover:text-white transition-colors">
            Privacy Policy
          </a>
          <a href="/terms/" class="text-gray-400 hover:text-white transition-colors">
            Terms of Service
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
