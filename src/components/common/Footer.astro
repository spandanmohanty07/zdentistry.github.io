---
const treatments = [
  { label: 'Dental Check-up', href: '/treatments/dentistry/dental-checkup/' },
  { label: 'Tooth Fillings', href: '/treatments/dentistry/tooth-fillings/' },
  { label: 'Cosmetic Dentistry', href: '/treatments/dentistry/cosmetic-dentistry/' },
  { label: 'Dental Implants', href: '/treatments/dentistry/dental-implants/' },
  { label: 'Emergency Dental', href: '/treatments/dentistry/emergency-dental/' },
];

const quickLinks = [
  { label: 'About Us', href: '/about/' },
  { label: 'All Treatments', href: '/treatments/' },
  { label: 'Dental Health Blog', href: '/blog/' },
  { label: 'Contact Us', href: '/contact/' },
  { label: 'Book Appointment', href: '/book-appointment/' },
];
---

<footer class="bg-secondary-900 text-white">
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand Section -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-6">
          <img src="/logo.svg" alt="ZDentistry Logo" class="h-12 w-auto brightness-0 invert" width="1046" height="157" />
        </a>
        <p class="text-gray-400 mb-6">
          Trust Your Smile to the Best: ZDentistry, Cuttack's Premier Dental Practice. Book for you and the family at the same time for real convenience!
        </p>
        <!-- Social Media Links -->
        <div class="flex gap-4 mb-6">
          <a href="https://www.facebook.com/people/Z-Dentistry/100086377687319/" target="_blank" rel="noopener noreferrer" aria-label="Follow ZDentistry on Facebook" class="text-gray-400 hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
          <a href="https://g.page/r/CRZ6N6fvkOdnEAE/review" target="_blank" rel="noopener noreferrer" aria-label="Review ZDentistry on Google" class="text-gray-400 hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          </a>
        </div>
      </div>

      <!-- Treatments -->
      <div>
        <h3 class="text-lg font-semibold mb-6">Treatments</h3>
        <ul class="space-y-3">
          {treatments.map((item) => (
            <li>
              <a href={item.href} class="text-gray-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-6">Quick Links</h3>
        <ul class="space-y-3">
          {quickLinks.map((item) => (
            <li>
              <a href={item.href} class="text-gray-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-semibold mb-6">Contact Us</h3>
        <div class="space-y-4">
          <div>
            <h4 class="font-medium text-sm text-gray-300 mb-1">Opening Hours</h4>
            <p class="text-gray-400 text-sm">
              Monday - Saturday<br />
              10AM - 2PM & 5PM - 9PM
            </p>
            <p class="text-gray-400 text-sm mt-2">
              Sunday<br />
              10AM - 2PM
            </p>
          </div>
          <div>
            <h4 class="font-medium text-sm text-gray-300 mb-1">Phone</h4>
            <a href="tel:+918984489929" class="text-gray-400 hover:text-white transition-colors block">
              +91 89844 89929
            </a>
            <a href="tel:+918984469929" class="text-gray-400 hover:text-white transition-colors block">
              +91 89844 69929
            </a>
          </div>
          <div>
            <h4 class="font-medium text-sm text-gray-300 mb-1">Address</h4>
            <address class="text-gray-400 text-sm not-italic">
              ZDentistry<br />
              2B / 109, Near Jugal Kishore Park<br />
              CDA Sector-9, Cuttack<br />
              Odisha 753014, India
            </address>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="border-t border-gray-800">
    <div class="container-custom py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-gray-400 text-sm">
          Copyright {new Date().getFullYear()} &copy; ZDentistry. All rights reserved.
        </p>
        <div class="flex gap-6 text-sm">
          <a href="/privacy/" class="text-gray-400 hover:text-white transition-colors">
            Privacy Policy
          </a>
          <a href="/terms/" class="text-gray-400 hover:text-white transition-colors">
            Terms of Service
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
