---
export interface Props {
  title?: string;
  subtitle?: string;
  variant?: 'primary' | 'dark';
}

const {
  title = "Get the Smile You Deserve",
  subtitle = "Book Your Dental Appointment with ZDentistry Today!",
  variant = 'primary'
} = Astro.props;

const bgClass = variant === 'dark' ? 'bg-secondary-900' : 'bg-primary-700';
---

<section class={`section ${bgClass} text-white`}>
  <div class="container-custom text-center">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
      {title}
    </h2>
    <p class="text-xl md:text-2xl mb-8 max-w-2xl mx-auto">
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/book-appointment/" class="btn-outline-white">
        Book Appointment
      </a>
      <a href="tel:+918984489929" class="btn bg-white text-primary-700 hover:bg-gray-100">
        Call: +91 89844 89929
      </a>
    </div>
  </div>
</section>
