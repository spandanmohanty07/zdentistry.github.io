---
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-50 to-white py-16 md:py-24 lg:py-32">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="animate-slide-up">
        <p class="text-primary font-semibold mb-2">Best Dental Clinic in Cuttack, CDA Sector-9</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-secondary-900 leading-tight">
          Best Dental Clinic in Cuttack for Your <span class="text-primary">Oral Health</span>
        </h1>
        <h2 class="text-xl md:text-2xl font-display text-secondary-700 mt-4">
          ZDentistry - Best Dental Clinic in Cuttack & CDA
        </h2>
        <p class="text-lg text-secondary-600 mt-6 leading-relaxed">
          Welcome to ZDentistry — your trusted partner for complete oral health in Cuttack. Our dental professionals specialize in implants, cosmetic dentistry, and maxillofacial surgery. From routine teeth and gum care to advanced procedures, we deliver results you can smile about.
        </p>
        <p class="text-secondary-500 mt-4">
          We offer professional cleaning, restorations, and preventive care — all under one roof. Trusted by thousands of patients across Cuttack, Bhubaneswar & Odisha. Book your appointment today!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-8">
          <a href="/book-appointment/" class="btn-primary">
            Book Appointment
          </a>
          <a href="tel:+918984489929" class="btn-outline">
            Call: +91 89844 89929
          </a>
        </div>
        <!-- Trust indicators -->
        <div class="flex flex-wrap items-center gap-6 mt-8 text-sm text-secondary-600">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span><strong>4.9/5</strong> Rating</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span><strong>5000+</strong> Happy Patients</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span><strong>Expert</strong> MDS Dentist</span>
          </div>
        </div>
      </div>
      <div class="relative animate-fade-in">
        <div class="rounded-3xl overflow-hidden shadow-2xl">
          <img
            src="/images/clinic-1.png"
            alt="ZDentistry modern dental treatment room with state-of-the-art equipment"
            class="w-full h-auto object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-2xl shadow-lg max-w-xs">
          <p class="text-sm font-medium text-secondary-900">
            "Eliminate the Unknown - Trust in Our Professional Dental Care"
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-primary/5 to-transparent pointer-events-none"></div>
</section>
