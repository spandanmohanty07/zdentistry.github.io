---
export interface Props {
  name: string;
  role: string;
  location: string;
  text: string;
}

const { name, role, location, text } = Astro.props;
---

<div class="card bg-white">
  <div class="flex flex-col h-full">
    <div class="flex-grow">
      <svg class="w-8 h-8 text-primary/30 mb-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
      </svg>
      <p class="text-secondary-700 leading-relaxed">{text}</p>
    </div>
    <div class="mt-6 pt-6 border-t border-gray-100">
      <p class="font-semibold text-secondary-900">{name}</p>
      <p class="text-sm text-secondary-500">{role}, {location}</p>
    </div>
  </div>
</div>
